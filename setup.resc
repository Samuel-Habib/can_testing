Clear
logFile @logs/renode.log

# ============================ GLOBAL SETUP ============================
emulation CreateUartPtyTerminal "term" "/tmp/uart" true
emulation CreateCANHub "canHub"

# ============================ MACHINE 0 SETUP ============================
mach create "machine-0"
machine LoadPlatformDescription @platforms/cpus/stm32h753.repl

# Set context and connect peripherals directly
mach set "machine-0"
sysbus Unregister sysbus.pwr
sysbus Unregister sysbus.watchdog
sysbus SilenceRange <0x58004800 0x400>
sysbus SilenceRange <0x5C001000 0x400>
sysbus SilenceRange <0x51008100 0x100>
logLevel 3 sysbus.rcc
logLevel 3 sysbus.syscfg
logLevel 3 sysbus.adcM1S2
logLevel 3 sysbus.dma1
logLevel 3 sysbus.timer2
logLevel 3 sysbus.fdcan1
machine PyDevFromFile @pwr_mock.py 0x58024800 0x400 false "pwr"
connector Connect sysbus.usart1 term
connector Connect sysbus.fdcan1 canHub

# Renode Built-In Tracing Setup
sysbus.cpu CreateExecutionTracing "cpu_tracer" "/root/dev/ru-solar/ru-pdu-tel/logs/trace.log" Disassembly false false
sysbus LogPeripheralAccess sysbus.fdcan1
sysbus LogPeripheralAccess sysbus.usart1
sysbus LogPeripheralAccess sysbus.adcM1S2
sysbus LogPeripheralAccess sysbus.dma1
sysbus LogPeripheralAccess sysbus.timer2
sysbus LogPeripheralAccess sysbus.syscfg
sysbus LogPeripheralAccess sysbus.rcc
sysbus LogPeripheralAccess sysbus.pwr

macro reset
"""
    sysbus LoadELF @build/ru-tel.elf
    cpu VectorTableOffset 0x08000000
    cpu SP 0x20020000
    cpu PerformanceInMips 100
"""

# ============================ MACHINE 1 SETUP ============================
mach create "machine-1"
machine LoadPlatformDescription @platforms/cpus/stm32h753.repl

mach set "machine-1"
sysbus Unregister sysbus.pwr
sysbus Unregister sysbus.watchdog
sysbus SilenceRange <0x58004800 0x400>
sysbus SilenceRange <0x5C001000 0x400>
sysbus SilenceRange <0x51008100 0x100>
logLevel 3 sysbus.rcc
logLevel 3 sysbus.syscfg
logLevel 3 sysbus.adcM1S2
logLevel 3 sysbus.dma1
logLevel 3 sysbus.timer2
logLevel 3 sysbus.fdcan1
machine PyDevFromFile @pwr_mock.py 0x58024800 0x400 false "pwr"
connector Connect sysbus.fdcan1 canHub

macro reset
"""
    sysbus LoadELF @build/ru-tel.elf
    cpu VectorTableOffset 0x08000000
    cpu SP 0x20020000
    cpu PerformanceInMips 100
"""

# ============================ EXECUTION ============================
mach set "machine-0"
runMacro $reset
mach set "machine-1"
runMacro $reset

mach set "machine-0"
machine StartGdbServer 3333

# Start the emulation automatically
start
